# tests/cmake/vcpkg_pin_test.cmake (MK64 Online, Fase 0.1). From the fork root: cmake -P tests/cmake/vcpkg_pin_test.cmake
# Hermetic: a throwaway local repo stands in for microsoft/vcpkg; GIT_ALLOW_PROTOCOL=file makes any https clone
# FAIL instead of downloading the real vcpkg (so the RED run needs no network either). Exit 0 + "ALL PASS" = GREEN.
cmake_minimum_required(VERSION 3.19)
get_filename_component(FORK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(DEFINED PIN_TEST_CHILD)  # child mode: one macro call in a fresh CMake process
  include("${FORK_ROOT}/cmake/automate-vcpkg.cmake")
  if(PIN_TEST_CHILD STREQUAL "print-default")
    message(STATUS "PIN_DEFAULT=[${VCPKG_PIN_COMMIT}] URL_DEFAULT=[${VCPKG_GIT_URL}]")
  else()
    _install_or_update_vcpkg()
  endif()
  return()
endif()
foreach(kv GIT_ALLOW_PROTOCOL=file GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_AUTHOR_NAME=pin-test
           GIT_AUTHOR_EMAIL=pin@test.invalid GIT_COMMITTER_NAME=pin-test GIT_COMMITTER_EMAIL=pin@test.invalid)
  string(REPLACE "=" ";" kv "${kv}")
  list(GET kv 0 k)
  list(GET kv 1 v)
  set(ENV{${k}} "${v}")
endforeach()
set(TMP "$ENV{TMPDIR}")
if(TMP STREQUAL "")
  set(TMP /tmp)
endif()
string(REGEX REPLACE "/+$" "" TMP "${TMP}")
string(RANDOM LENGTH 8 rnd)
set(W "${TMP}/vcpkg-pin-test-${rnd}")
set(FAILS 0)
function(g dir)  # g(<dir> <git args...>) -> GIT_OUT, GIT_RC
  execute_process(COMMAND git -C "${dir}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE o
                  ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(GIT_OUT "${o}" PARENT_SCOPE)
  set(GIT_RC "${rc}" PARENT_SCOPE)
endfunction()
function(run root pin)  # child macro call -> RC, LOG (whitespace collapsed: CMake word-wraps WARNING text)
  execute_process(COMMAND ${CMAKE_COMMAND} -DPIN_TEST_CHILD=run "-DVCPKG_ROOT=${root}"
                  "-DVCPKG_GIT_URL=file://${W}/origin.git" "-DVCPKG_PIN_COMMIT=${pin}"
                  -P "${CMAKE_CURRENT_LIST_FILE}" WORKING_DIRECTORY "${W}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${o}${e}")
  set(RC "${rc}" PARENT_SCOPE)
  set(LOG "${flat}" PARENT_SCOPE)
endfunction()
function(boots root)  # BOOTS = number of times the fake bootstrap ran in <root>
  set(n 0)
  if(EXISTS "${root}/bootstrap.count")
    file(STRINGS "${root}/bootstrap.count" l)
    list(LENGTH l n)
  endif()
  set(BOOTS ${n} PARENT_SCOPE)
endfunction()
macro(check name actual expected)
  if("${actual}" STREQUAL "${expected}")
    message(STATUS "PASS ${name}")
  else()
    message(STATUS "FAIL ${name}: expected [${expected}] got [${actual}]")
    math(EXPR FAILS "${FAILS}+1")
  endif()
endmacro()

# Fake vcpkg: README.md (macro clone check :130), bootstrap script that writes the untracked `vcpkg`
# stub and counts its runs, a MARKER that differs per commit. C2 is the default-branch tip.
file(MAKE_DIRECTORY "${W}/src")
g("${W}/src" init -q -b master)
file(WRITE "${W}/src/README.md" "fake vcpkg\n")
file(WRITE "${W}/src/.gitignore" "/vcpkg\n/bootstrap.count\n")
file(WRITE "${W}/src/bootstrap-vcpkg.sh"
     "#!/bin/sh\nprintf '#!/bin/sh\\n' > vcpkg && chmod +x vcpkg && echo run >> bootstrap.count\n")
file(CHMOD "${W}/src/bootstrap-vcpkg.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
foreach(n 1 2)
  file(WRITE "${W}/src/MARKER" "${n}\n")
  g("${W}/src" add -A)
  g("${W}/src" commit -q -m c${n})
  g("${W}/src" rev-parse HEAD)
  set(C${n} "${GIT_OUT}")
endforeach()
g("${W}" clone -q --bare src origin.git)
if(NOT GIT_RC EQUAL 0 OR C1 STREQUAL "" OR C2 STREQUAL "")
  message(FATAL_ERROR "test setup failed (work dir kept: ${W})")
endif()
set(R "${W}/vcpkg")

run("${R}" "${C1}")                                   # S1 fresh clone, pinned to C1
check("S1 exit code" "${RC}" "0")
g("${R}" rev-parse HEAD)
check("S1 fresh clone HEAD == C1" "${GIT_OUT}" "${C1}")
g("${R}" symbolic-ref -q HEAD)
check("S1 HEAD detached" "${GIT_RC}" "1")
string(REGEX MATCH "differs from vcpkg.json builtin-baseline" w "${LOG}")
check("S1 warns pin != baseline" "${w}" "differs from vcpkg.json builtin-baseline")
run("${R}" "${C1}")                                   # S2 second call, nothing changed
g("${R}" rev-parse HEAD)
boots("${R}")
check("S2 reuse keeps C1" "${GIT_OUT}" "${C1}")
check("S2 bootstrap ran once in total" "${BOOTS}" "1")
g("${R}" checkout -q --detach "${C2}")                # S3 drift: C2 checked out by hand
run("${R}" "${C1}")
g("${R}" rev-parse HEAD)
boots("${R}")
check("S3 drift restored to C1" "${GIT_OUT}" "${C1}")
check("S3 tool re-bootstrapped after HEAD moved" "${BOOTS}" "2")
g("${W}/src" switch -q -c side)                       # S4 pin = commit the clone never saw, off the default branch
file(WRITE "${W}/src/MARKER" "3\n")
g("${W}/src" commit -q -am c3)
g("${W}/src" rev-parse HEAD)
set(C3 "${GIT_OUT}")
g("${W}/src" push -q "${W}/origin.git" side)
run("${R}" "${C3}")
g("${R}" rev-parse HEAD)
check("S4 unseen pin fetched + checked out" "${GIT_OUT}" "${C3}")
run("${R}" deadbeefdeadbeefdeadbeefdeadbeefdeadbeef)  # S5 unreachable pin
string(COMPARE NOTEQUAL "${RC}" "0" nz)
check("S5 unreachable pin fails the configure (rc != 0)" "${nz}" "1")
g("${R}" rev-parse HEAD)
check("S5 HEAD untouched after failed pin" "${GIT_OUT}" "${C3}")
run("${R}" master)                                    # S6 not a 40-hex SHA
string(COMPARE NOTEQUAL "${RC}" "0" nz)
check("S6 malformed pin fails the configure (rc != 0)" "${nz}" "1")
file(STRINGS "${FORK_ROOT}/vcpkg.json" bl REGEX "builtin-baseline")   # S7 default pin; oracle by regex, not string(JSON)
string(REGEX REPLACE ".*\"builtin-baseline\" *: *\"([0-9a-f]+)\".*" "\\1" bl "${bl}")
execute_process(COMMAND ${CMAKE_COMMAND} -DPIN_TEST_CHILD=print-default -P "${CMAKE_CURRENT_LIST_FILE}"
                WORKING_DIRECTORY "${W}" OUTPUT_VARIABLE o ERROR_VARIABLE e)
string(REGEX MATCH "PIN_DEFAULT=\\[([0-9a-f]*)\\]" _ "${o}${e}")
check("S7 default pin == vcpkg.json baseline ${bl}" "${CMAKE_MATCH_1}" "${bl}")
string(REGEX MATCH "URL_DEFAULT=\\[([^]]*)\\]" _ "${o}${e}")
check("S7 default URL" "${CMAKE_MATCH_1}" "https://github.com/Microsoft/vcpkg.git")
g("${W}" clone -q "file://${W}/origin.git" optout)   # S8 empty pin = upstream behaviour (git pull)
g("${W}/optout" reset -q --hard "${C1}")
run("${W}/optout" "")
g("${W}/optout" rev-parse HEAD)
check("S8 empty pin keeps upstream git pull" "${GIT_OUT}" "${C2}")

if(FAILS EQUAL 0)
  file(REMOVE_RECURSE "${W}")
  message(STATUS "vcpkg_pin_test: ALL PASS")
else()
  message(FATAL_ERROR "vcpkg_pin_test: ${FAILS} check(s) FAILED (work dir kept: ${W})")
endif()
